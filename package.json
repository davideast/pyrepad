{
  "name": "@pyric/pad",
  "description": "The modern ES Module, TypeScript-ready real-time collaborative code and text editing engine for the Pyric ecosystem",
  "version": "2.0.0",
  "author": "David East & Pyric Ecosystem Contributors",
  "contributors": [
    "David East <dceast@gmail.com>",
    "Michael Lehenbauer <michael@firebase.com>"
  ],
  "homepage": "https://github.com/davideast/pyrepad",
  "repository": {
    "type": "git",
    "url": "https://github.com/davideast/pyrepad.git"
  },
  "browser": {
    "jsdom": false
  },
  "bugs": {
    "url": "https://github.com/davideast/pyrepad/issues"
  },
  "licenses": [
    {
      "type": "MIT",
      "url": "http://firebase.mit-license.org/"
    }
  ],
  "keywords": [
    "text",
    "word",
    "editor",
    "firebase",
    "realtime",
    "collaborative"
  ],
  "main": "dist/firepad.min.js",
  "files": [
    "src/**",
    "types/**",
    "dist/**",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "peerDependencies": {
    "firebase": "^7.13.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@playwright/test": "^1.62.0",
    "@pyric/cli": "./.pyric-local/pyric-cli-0.1.0-alpha.24.tgz",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "codemirror": "^5.58.2",
    "create-pyric": "./.pyric-local/create-pyric-0.1.0-alpha.24.tgz",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase": "^7.13.2",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.2.0",
    "playwright": "^1.62.0",
    "prettier": "^3.9.6",
    "pyric": "./.pyric-local/pyric-0.1.0-alpha.24.tgz",
    "pyric-admin": "./.pyric-local/pyric-admin-0.1.0-alpha.24.tgz",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.5.0",
    "vite": "^5.3.0"
  },
  "scripts": {
    "test": "bun test test/specs/*.spec.js",
    "dev": "vite",
    "build": "bun run build:bundle",
    "build:bundle": "bun -e \"require('./tools/bundle.js')\"",
    "typecheck": "tsc --noEmit",
    "test:integration": "PYRIC_SANDBOX=1 bun test test/specs/integration.spec.js",
    "test:seam": "bun test test/specs/sync-seam.spec.js",
    "test:e2e:sandbox": "bun test test/specs/e2e-sandbox.spec.js",
    "test:formatting": "bun test test/specs/pure-formatting.spec.js",
    "test:headless:speed": "bun test test/specs/headless-speed.spec.js",
    "test:ot:ghost": "bun test test/specs/ot-ghost.spec.js",
    "verify:agentive:harness": "bun test test/specs/agentive-harness.spec.js",
    "test:e2e:playwright": "playwright test",
    "lint": "eslint src/",
    "prepare": "husky || true"
  },
  "exports": {
    ".": "./dist/firepad.min.js",
    "./core": "./src/core/index.ts",
    "./adapters": "./src/adapters/index.ts",
    "./editors": "./src/editors/index.ts",
    "./react": "./src/react/index.ts"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "overrides": {
    "pyric": "./.pyric-local/pyric-0.1.0-alpha.24.tgz",
    "pyric-admin": "./.pyric-local/pyric-admin-0.1.0-alpha.24.tgz",
    "create-pyric": "./.pyric-local/create-pyric-0.1.0-alpha.24.tgz"
  }
}
